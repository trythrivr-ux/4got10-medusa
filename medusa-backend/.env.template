# CORS - Add your Vercel frontend URL here (e.g., https://your-app.vercel.app)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# Database - Railway will provide DATABASE_URL automatically when you add PostgreSQL
DATABASE_URL=
DB_NAME=medusa-v2

# Redis (optional, for production caching)
REDIS_URL=redis://localhost:6379

# Secrets - CHANGE THESE IN PRODUCTION!
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# File Provider (S3-compatible). For Railway Buckets, map these to Railway bucket variables.
# S3_FILE_URL should point to your backend proxy route (e.g., https://api.yourdomain.com/files)
# since Railway Buckets are private and not directly publicly accessible.
S3_FILE_URL=http://localhost:9000/files

# S3 Bucket Configuration (Railway Bucket or other S3-compatible storage)
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
