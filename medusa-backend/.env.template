# CORS - Add your Vercel frontend URL here (e.g., https://your-app.vercel.app)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# Database - Railway will provide DATABASE_URL automatically when you add PostgreSQL
DATABASE_URL=
DB_NAME=medusa-v2

# Redis (optional, for production caching)
REDIS_URL=redis://localhost:6379

# Secrets - CHANGE THESE IN PRODUCTION!
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Railway Storage Bucket (S3-compatible storage for images)
# Railway automatically provides these when you connect a bucket to your service
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_REGION=

# File Provider (S3-compatible). For Railway Buckets, map these to RAILWAY_BUCKET_*.
S3_FILE_URL=

# Alternative: DigitalOcean Spaces (if not using Railway Storage)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
